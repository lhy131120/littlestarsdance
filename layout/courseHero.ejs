<section id="hero" class="hero overflow-hidden">
	<picture class="position-absolute top-0 start-0 w-100 h-100 z-n1" data-aos="fade-in" data-aos-duration="1000" data-aos-delay="0">
		<img
			src="<%= (typeof heroImageSrc !== 'undefined' && heroImageSrc) ? heroImageSrc : '/assets/images/inside-heros/hero-1.jpg' %>"
			alt="hero image"
			class="w-100 h-100 object-fit-cover object-position-center"
      loading="lazy"
		/>
	</picture>

	<div class="container position-relative z-3">
		<div class="py-5">
			<h1 class="mb-0 mb-lg-6 fs-3 fs-lg-1 lh-sm lh-lg-base letter-spacing-1 text-center" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">
				與我們一起探索舞蹈的樂趣<br class="d-none d-lg-block" />為兒童和青少年提供精彩的舞蹈課程
			</h1>

			<div class="d-none d-lg-flex align-items-center justify-content-center gap-3 flex-wrap" data-aos="fade-up" data-aos-duration="800" data-aos-delay="300">
				<p class="mb-0 fs-6 fs-lg-5 letter-spacing-1">按年齡篩選：</p>
				<div id="course-filters" class="d-flex align-items-center justify-content-center gap-4 gap-lg-5 flex-wrap">
					<button type="button" class="btn btn-primary-300" data-range="all" data-aos="fade-up" data-aos-duration="800" data-aos-delay="0">所有課程</button>
					<button type="button" class="btn btn-primary-300" data-range="kids" data-aos="fade-up" data-aos-duration="800" data-aos-delay="100">3-6歲</button>
					<button type="button" class="btn btn-primary-300" data-range="children" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">7-12歲</button>
					<button type="button" class="btn btn-primary-300" data-range="teenages" data-aos="fade-up" data-aos-duration="800" data-aos-delay="300">13-16歲</button>
				</div>
			</div>
		</div>
	</div>
</section>