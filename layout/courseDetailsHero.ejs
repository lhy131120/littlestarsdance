<section
	id="hero"
	class="hero overflow-hidden <%= (typeof isCoursesDetailsPage !== 'undefined' && isCoursesDetailsPage) ? 'course-details-hero' : null %>"
>
	<picture class="position-absolute top-0 start-0 w-100 h-100 z-n1" data-aos="fade-in" data-aos-duration="1000" data-aos-delay="0">
		<img
			src="<%= (typeof heroImageSrc !== 'undefined' && heroImageSrc) ? heroImageSrc : '/assets/images/inside-heros/hero-1.jpg' %>"
			alt="hero image"
			class="w-100 h-100 object-fit-cover object-position-center"
      loading="lazy"
		/>
	</picture>

	<div class="container position-relative z-3">
		<div class="py-5">
			<h1 class="mb-4 mb-lg-7 fs-3 fs-lg-1 letter-spacing-1 text-center" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200"><%- courseName %></h1>

			<% if (typeof label !== 'undefined' && Array.isArray(label) && label.length > 0) { %>
			<div class="d-flex align-items-center justify-content-center gap-3 flex-wrap" data-aos="fade-up" data-aos-duration="800" data-aos-delay="300">
				<% label.forEach(function(item, index) { %>
				<span class="badge text-gray-900 rounded-5 bg-primary-300 px-4 py-1 fs-7 fs-lg-6 letter-spacing-1" data-aos="fade-up" data-aos-duration="800" data-aos-delay="<%= index * 100 %>">
          <%= item %>
        </span>
				<% }); %>
			</div>
			<% } %>
		</div>
	</div>
</section>