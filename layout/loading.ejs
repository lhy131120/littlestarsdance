<div id="loading">
	<div class="spinner"></div>
</div>

<style>
	#loading {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(255, 255, 255, 0.95); /* 半透明背景 */
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 9999; /* 確保在最上層 */
	}

	/* Spinner 動畫 */
	.spinner {
		border: 8px solid #f3f3f3; /* 灰色邊框 */
		border-top: 8px solid #a46305; /* 藍色頂邊 */
		border-radius: 50%;
		width: 60px;
		height: 60px;
		animation: spin 1s linear infinite; /* 旋轉動畫 */
	}

	@keyframes spin {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(360deg);
		}
	}

	/* 隱藏 Loading 的類別 */
	#loading.hidden {
		display: none;
	}
</style>
